APP_NAME="NÜM Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://academy.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

ACADEMY_NAME="NÜM Academy"
ACADEMY_SHORT_NAME="NÜM"
ACADEMY_DESCRIPTOR="Academy OS"
ACADEMY_LOGO_URL=
ACADEMY_THEME_PRESET=soft-glass
ACADEMY_PRIMARY="#6F7F70"
ACADEMY_PRIMARY_HOVER="#576A59"
ACADEMY_PRIMARY_SOFT="#EAF0E8"
ACADEMY_PRIMARY_SURFACE="#F4F7F2"
ACADEMY_SECONDARY="#202720"
ACADEMY_ACCENT="#B79B72"
ACADEMY_RADIUS=1rem
ACADEMY_DENSITY=comfortable
ACADEMY_DEPLOYMENT_MODE=single-tenant
ACADEMY_TEMPLATE_KEY=creator
ACADEMY_CAPABILITY_PROFILE=creator
ACADEMY_FEATURE_COMMUNITY=true
ACADEMY_FEATURE_EVENTS=true
ACADEMY_FEATURE_AI=true
ACADEMY_FEATURE_TUTOR=true
ACADEMY_FEATURE_SALES=true
ACADEMY_FEATURE_PAGES=true
ACADEMY_FEATURE_MCP=true
ACADEMY_FEATURE_TOWER=false
ACADEMY_FEATURE_ASSESSMENTS=true
ACADEMY_FEATURE_ASSIGNMENTS=true
ACADEMY_FEATURE_COMPLETION=true
ACADEMY_FEATURE_CERTIFICATES=true
ACADEMY_FEATURE_DRIP=true
ACADEMY_COMPLETION_REQUIRE_ALL_ACCESSIBLE_LESSONS=true
ACADEMY_CERTIFICATE_ISSUER_NAME=
ACADEMY_CERTIFICATE_TITLE="Certificat de réussite"
ACADEMY_CERTIFICATE_PUBLIC_VERIFICATION=true
ACADEMY_CERTIFICATE_PDF_DOWNLOAD=true
ACADEMY_CERTIFICATE_STUDENT_SHARING=true

# Child instance bootstrap (Factory injects these; password is cleared after healthcheck)
ACADEMY_BOOTSTRAP_OWNER_NAME=
ACADEMY_BOOTSTRAP_OWNER_EMAIL=
ACADEMY_BOOTSTRAP_OWNER_PASSWORD=

# Academy Factory control-plane (enable only on the internal Factory instance)
ACADEMY_FACTORY_ENABLED=false
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_DESTINATION_UUID=
ACADEMY_FACTORY_SOURCE_MODE=public
ACADEMY_FACTORY_GIT_REPOSITORY=
ACADEMY_FACTORY_GIT_BRANCH=main
ACADEMY_FACTORY_PRIVATE_KEY_UUID=
ACADEMY_FACTORY_COMPOSE_LOCATION=/docker-compose.coolify.yml
ACADEMY_FACTORY_DOMAIN_SCHEME=https
ACADEMY_FACTORY_HEALTH_PATH=/up

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=num_academy
DB_USERNAME=num_academy
DB_PASSWORD=
DB_SSLMODE=prefer

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=public
MEDIA_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CLIENT_ID=
STRIPE_TRAINER_PRICE_ID=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_ENDPOINT_URL=

INERTIA_SSR_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# Academy AI
# Academy AI provider: openai | deepseek | disabled
ACADEMY_AI_PROVIDER=openai
ACADEMY_AI_TIMEOUT=90
# Optional cross-provider overrides. Leave blank to use provider defaults.
ACADEMY_AI_MODEL=
ACADEMY_AI_BASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ACADEMY_IMAGE_PROVIDER=gemini
ACADEMY_TTS_PROVIDER=openai
ACADEMY_MEDIA_TIMEOUT=180

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=high

# Academy MCP Gateway (CLI/agent clients usually send no Origin header)
ACADEMY_MCP_ALLOWED_ORIGINS=

ACADEMY_VERSION=1.5.2
ACADEMY_MCP_MAX_BODY_BYTES=1048576


# NÜM Mission Tower (M13.0 foundation)
# Minimum viable Tower: enabled + Academy MCP token + an Academy AI provider.
TOWER_ENABLED=false

TOWER_CHAT_ENABLED=true
TOWER_CHAT_REQUEST_TIMEOUT=180
TOWER_CHAT_HISTORY_MESSAGES=8
TOWER_CHAT_MAX_MESSAGE_LENGTH=12000
TOWER_CHAT_AUTO_RUN_READ=true
TOWER_AI_PROVIDER=inherit
TOWER_AI_MODEL=
TOWER_ACADEMY_MCP_URL="${APP_URL}/mcp"
TOWER_ACADEMY_MCP_TOKEN=
TOWER_ACADEMY_MCP_TIMEOUT=10
TOWER_ACADEMY_MCP_IN_PROCESS=true

# Optional NümFlow bridge (durable mission execution in later M13 slices)
TOWER_NUMFLOW_ENABLED=false
TOWER_NUMFLOW_URL=
TOWER_NUMFLOW_TOKEN=

# Optional NÜM Harness bridge (strong approvals/evidence in later M13 slices)
TOWER_HARNESS_ENABLED=false
TOWER_HARNESS_URL=
TOWER_HARNESS_TOKEN=

# Optional fleet control. Reuses the Coolify credentials configured for Factory.
TOWER_FLEET_ENABLED=false
TOWER_MAX_MISSION_STEPS=24
TOWER_MAX_PARALLEL_STEPS=4

# NÜM Academy AI Tutor / RAG
ACADEMY_TUTOR_ENABLED=true
ACADEMY_TUTOR_PROVIDER=inherit
ACADEMY_TUTOR_MODEL=
ACADEMY_TUTOR_PREMIUM_MODEL=
ACADEMY_TUTOR_PERSONALITY=helpful
ACADEMY_TUTOR_OUTSIDE_CONTENT=never
ACADEMY_TUTOR_DAILY_LIMIT=20
ACADEMY_TUTOR_MONTHLY_BUDGET_CENTS=0
ACADEMY_TUTOR_RETRIEVAL_LIMIT=6
ACADEMY_TUTOR_RETRIEVAL_MIN_SIMILARITY=0.20
ACADEMY_TUTOR_MAX_CONTEXT_CHARS=18000
ACADEMY_TUTOR_CONVERSATION_MESSAGES=8
ACADEMY_EMBEDDING_PROVIDER=disabled
ACADEMY_EMBEDDING_MODEL=text-embedding-3-small
ACADEMY_EMBEDDING_DIMENSIONS=1536
ACADEMY_TUTOR_INPUT_COST_PER_MILLION_CENTS=0
ACADEMY_TUTOR_OUTPUT_COST_PER_MILLION_CENTS=0

# Academy Commerce (M10)
ACADEMY_PLATFORM_FEE_BPS=1500
ACADEMY_DEFAULT_AFFILIATE_BPS=1000
ACADEMY_COMMERCE_CURRENCY=EUR
ACADEMY_REFUND_CONFIRMATION_PREFIX="REFUND ORDER"

# Mission Tower Observatory
TOWER_OBSERVATORY_ENABLED=true
TOWER_OBSERVATORY_REFUND_RATE_WARN=5
TOWER_OBSERVATORY_CONVERSION_DROP_PCT=15
TOWER_OBSERVATORY_LEARNING_RISK_PCT=25
TOWER_OBSERVATORY_EVENT_FILL_WARN=30
TOWER_OBSERVATORY_COMMUNITY_SILENCE_HOURS=72
TOWER_OBSERVATORY_AI_COST_SPIKE_PCT=50
TOWER_OBSERVATORY_AI_COST_MIN_BASELINE_CENTS=100


# Mission Tower durable memory (M13.5)
TOWER_MEMORY_ENABLED=true
TOWER_MEMORY_MAX_CONTEXT=8
TOWER_MEMORY_SEMANTIC=true
TOWER_MEMORY_RETENTION_DAYS=365
TOWER_MEMORY_THREAD_RETENTION_DAYS=30
TOWER_CHAT_SUMMARY_TRIGGER_MESSAGES=16
TOWER_CHAT_SUMMARY_BATCH_MESSAGES=16
TOWER_CHAT_MAX_SUMMARY_LENGTH=6000

# Gemini / Nano Banana image generation
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
ACADEMY_IMAGE_SIZE=1K
ACADEMY_IMAGE_PROMPT_PRESET=academy-premium
ACADEMY_IMAGE_RESPECT_BRANDING=true
ACADEMY_IMAGE_AVOID_EMBEDDED_TEXT=true
